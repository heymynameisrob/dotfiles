#!/usr/bin/env bash
set -euo pipefail

readonly DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly HOME_PACKAGE="$DOTFILES_DIR/home"
readonly BREWFILE="$DOTFILES_DIR/packages/Brewfile"
readonly PI_DIR="$HOME_PACKAGE/.pi/agent"

function info() {
	printf '✓ %s\n' "$1"
}

function warn() {
	printf '⚠ %s\n' "$1" >&2
}

function fail() {
	printf '✗ %s\n' "$1" >&2
	return 1
}

function require_command() {
	command -v "$1" >/dev/null 2>&1 || fail "Missing command: $1"
}

function link_pi_directory() {
	local directory_name="$1"
	local source_directory="$PI_DIR/$directory_name"
	local target_directory="$HOME/.pi/agent/$directory_name"
	local unexpected_file
	local runtime_link
	local relative_path

	mkdir -p "$source_directory" "$(dirname "$target_directory")"

	if [[ -L "$target_directory" && "$(realpath "$target_directory")" == "$source_directory" ]]; then
		return 0
	fi

	if [[ -d "$target_directory" ]]; then
		unexpected_file="$(find "$target_directory" -type d -name node_modules -prune -o -type f -print -quit)"
		if [[ -n "$unexpected_file" ]]; then
			fail "Move local Pi source into the repository first: $unexpected_file"
			return 1
		fi

		while IFS= read -r -d '' runtime_link; do
			relative_path="${runtime_link#"$target_directory/"}"
			if [[ ! -e "$source_directory/$relative_path" && ! -L "$source_directory/$relative_path" ]]; then
				mkdir -p "$(dirname "$source_directory/$relative_path")"
				ln -s "$(readlink "$runtime_link")" "$source_directory/$relative_path"
			fi
		done < <(find "$target_directory" -type l -print0)

		rm -rf "$target_directory"
	elif [[ -e "$target_directory" || -L "$target_directory" ]]; then
		fail "Cannot replace Pi path: $target_directory"
		return 1
	fi

	ln -s "$source_directory" "$target_directory"
	info "Linked Pi $directory_name directory"
}

function link_pi_authored_directories() {
	link_pi_directory extensions
	link_pi_directory prompts
	link_pi_directory skills
}

function command_stow() {
	require_command stow
	link_pi_authored_directories
	stow --restow --no-folding --ignore='node_modules' --ignore='^\.pi/agent/(extensions|prompts|skills)' --dir "$DOTFILES_DIR" --target "$HOME" home
	info "Linked managed configuration into $HOME"
}

function command_unstow() {
	local directory_name

	require_command stow
	stow --delete --no-folding --ignore='node_modules' --ignore='^\.pi/agent/(extensions|prompts|skills)' --dir "$DOTFILES_DIR" --target "$HOME" home
	for directory_name in extensions prompts skills; do
		if [[ -L "$HOME/.pi/agent/$directory_name" && "$(realpath "$HOME/.pi/agent/$directory_name")" == "$PI_DIR/$directory_name" ]]; then
			rm "$HOME/.pi/agent/$directory_name"
		fi
	done
	info "Removed managed links from $HOME"
}

function command_check_stow() {
	require_command stow
	stow --restow --no-folding --simulate --verbose=1 --ignore='node_modules' --ignore='^\.pi/agent/(extensions|prompts|skills)' --dir "$DOTFILES_DIR" --target "$HOME" home
}

function prepare_managed_targets() {
	local source_file
	local relative_path
	local target_file

	while IFS= read -r -d '' source_file; do
		relative_path="${source_file#"$HOME_PACKAGE/"}"
		target_file="$HOME/$relative_path"

		if [[ -e "$target_file" || -L "$target_file" ]]; then
			if [[ ! -L "$target_file" || "$(realpath "$target_file" 2>/dev/null || true)" != "$source_file" ]]; then
				rm -f "$target_file"
				info "Replaced $relative_path"
			fi
		fi
	done < <(find "$HOME_PACKAGE" -type d \( -name node_modules -o -name .git -o -path "$HOME_PACKAGE/.claude" -o -path "$HOME_PACKAGE/.config/zed/prompts" -o -path "$HOME_PACKAGE/.pi/agent/extensions" -o -path "$HOME_PACKAGE/.pi/agent/prompts" -o -path "$HOME_PACKAGE/.pi/agent/skills" \) -prune -o -type f ! -iname '*backup*' ! -iname '*.bak' ! -iname '*.old' -print0)
}

function command_sync() {
	prepare_managed_targets
	command_stow
	info "Applied repository configuration to $HOME"
}

function command_sync_pi() {
	command_sync
}

function command_packages() {
	require_command brew
	brew bundle --file "$BREWFILE"
}

function register_pi_package() {
	local settings_file="$HOME/.pi/agent/settings.json"
	mkdir -p "$(dirname "$settings_file")"
	node - "$settings_file" "$HOME/.pi/agent" <<'NODE'
const fs = require('node:fs');
const settingsFile = process.argv[2];
const packagePath = process.argv[3];
const settings = fs.existsSync(settingsFile)
	? JSON.parse(fs.readFileSync(settingsFile, 'utf8'))
	: {};
const packages = Array.isArray(settings.packages) ? settings.packages : [];
settings.packages = [packagePath, ...packages.filter(function filterPackage(value) {
	return value !== packagePath && value !== `${process.env.HOME}/code/pi-config`;
})];
fs.writeFileSync(settingsFile, `${JSON.stringify(settings, null, 2)}\n`, { mode: 0o600 });
NODE
	chmod 600 "$settings_file"
}

function command_pi() {
	require_command npm
	(
		cd "$PI_DIR"
		npm ci
	)
	register_pi_package
	info "Installed and registered Pi package"
}

function command_doctor() {
	local failed=0
	local command_name

	for command_name in git brew stow node npm pi; do
		if command -v "$command_name" >/dev/null 2>&1; then
			info "$command_name is available"
		else
			warn "$command_name is not available"
			failed=1
		fi
	done

	if [[ -d "$HOME/code/pi-config/.pi" ]]; then
		warn "Legacy Pi runtime directory remains available for rollback: $HOME/code/pi-config/.pi"
	fi

	if grep -q 'PI_CODING_AGENT_DIR=.*pi-config' "$HOME/.zshrc" 2>/dev/null; then
		warn "~/.zshrc still points PI_CODING_AGENT_DIR at the old pi-config repository"
		failed=1
	fi

	if ! command_check_stow >/dev/null 2>&1; then
		warn "Stow found conflicting files. Run: dot check-stow"
		failed=1
	fi

	if [[ "$failed" -ne 0 ]]; then
		return 1
	fi

	info "No configuration problems found"
}

function command_init() {
	command_packages
	command_pi
	command_stow
	command_doctor
}

function command_update() {
	git -C "$DOTFILES_DIR" pull --ff-only
	command_packages
	command_pi
	command_stow
	command_doctor
}

function print_help() {
	cat <<'EOF'
Usage: dot <command>

Commands:
  init        Install packages, Pi dependencies, and managed links
  update      Pull changes and refresh packages, dependencies, and links
  packages    Install packages from packages/Brewfile
  pi          Install Pi package dependencies with npm ci
  sync        Apply repository configuration without removing unmanaged files
  sync-pi     Apply repository configuration; retained as a compatibility alias
  stow        Link home/ into the current home directory
  unstow      Remove links managed by this repository
  check-stow  Show link conflicts without changing files
  doctor      Check required tools, legacy Pi paths, and link conflicts
  help        Show this help
EOF
}

function main() {
	case "${1:-help}" in
		init) command_init ;;
		update) command_update ;;
		packages) command_packages ;;
		pi) command_pi ;;
		sync) command_sync ;;
		sync-pi) command_sync_pi ;;
		stow) command_stow ;;
		unstow) command_unstow ;;
		check-stow) command_check_stow ;;
		doctor) command_doctor ;;
		help|-h|--help) print_help ;;
		*) fail "Unknown command: $1"; print_help; return 1 ;;
	esac
}

main "$@"
